{
  "name": "@dentalos/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./control": "./src/control/index.ts",
    "./tenant": "./src/tenant/index.ts"
  },
  "scripts": {
    "db:generate": "npm run db:generate:control && npm run db:generate:tenant",
    "db:generate:control": "drizzle-kit generate --config drizzle.control.config.ts",
    "db:generate:tenant": "drizzle-kit generate --config drizzle.tenant.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no lint configured'"
  },
  "dependencies": {
    "@dentalos/core": "*",
    "drizzle-orm": "^0.38.3",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@dentalos/config": "*",
    "drizzle-kit": "^0.30.2",
    "typescript": "^5.7.3"
  }
}
